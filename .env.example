# App role (RLS enforced). Never use the admin URL in the app.
DATABASE_URL=postgres://veradact_app:veradact_app@localhost:54330/veradact
# Owner role: migrations and seed only
DATABASE_ADMIN_URL=postgres://veradact_admin:veradact_admin@localhost:54330/veradact
TEST_DATABASE_URL=postgres://veradact_app:veradact_app@localhost:54330/veradact_test
TEST_DATABASE_ADMIN_URL=postgres://veradact_admin:veradact_admin@localhost:54330/veradact_test
APP_URL=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3001/mcp
MCP_PORT=3001
# 32+ random bytes each; generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-change-me-session-secret-000000
LINK_SIGNING_SECRET=dev-only-change-me-link-secret-0000000
CRON_SECRET=dev-only-change-me-cron-secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:54331
EMAIL_FROM="Veradact <no-reply@veradact.local>"
