# Local Supabase stack from `pnpm db:up` (supabase/config.toml). Hosted Supabase project:
# ARCHITECTURE §17 (pooler URLs, ?sslmode=verify-full, ?prepare=false in transaction mode).
# App role (RLS enforced). Never use the admin URL in the app.
DATABASE_URL=postgres://veradact_app:veradact_app@localhost:54330/postgres
# Owner role (Supabase's postgres role): migrations and seed only
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54330/postgres
TEST_DATABASE_URL=postgres://veradact_app:veradact_app@localhost:54330/veradact_test
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54330/veradact_test
# PEM file of the database server's CA, for providers other than Supabase (whose root CA is built in). Empty locally.
DATABASE_CA_CERT_FILE=
APP_URL=http://localhost:3000
# Self-serve sign-up at /signup (D-062). Anything but "true" closes it.
SIGNUP_ENABLED=true
MCP_PUBLIC_URL=http://localhost:3001/mcp
MCP_PORT=3001
# Proxies in front of the apps that append to X-Forwarded-For (ARCHITECTURE §14): 1 = one load
# balancer or platform router (also right for local dev), 2 = CDN + load balancer, 0 = no proxy.
TRUSTED_PROXY_HOPS=1
# 32+ random bytes each; generate with: openssl rand -base64 32. Production refuses these placeholders.
SESSION_SECRET=dev-only-change-me-session-secret-000000
LINK_SIGNING_SECRET=dev-only-change-me-link-secret-0000000
CRON_SECRET=dev-only-change-me-cron-secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AI extraction client: anthropic | fixture (synthetic fixtures, nothing sent anywhere).
# Empty: anthropic when ANTHROPIC_API_KEY is set, else fixture (D-051).
MODEL_CLIENT=
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:54331
EMAIL_FROM="Veradact <no-reply@veradact.local>"
